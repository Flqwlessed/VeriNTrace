{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "web",
  "functions": {
    "api/dispatch.py": {
      "maxDuration": 180,
      "excludeFiles": "{tests/**,docs/**,data/**,.env,.env.*,frontend/**,*.zip}"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/dispatch?route=health"
    },
    {
      "source": "/api/demos",
      "destination": "/api/dispatch?route=demos"
    },
    {
      "source": "/api/investigate",
      "destination": "/api/dispatch?route=investigate"
    },
    {
      "source": "/api/verify",
      "destination": "/api/dispatch?route=verify"
    },
    {
      "source": "/api/demos/:slug",
      "destination": "/api/dispatch?route=demos/:slug"
    },
    {
      "source": "/history",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
        }
      ]
    }
  ]
}
